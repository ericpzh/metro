{
  // Metro Station Designer — deployed to Cloudflare Workers as static assets.
  // The site is built into web/dist by `npm run build`; nothing runs on a server.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metro",
  "compatibility_date": "2026-09-28",

  // The site is served from a path prefix — https://ericpzh.rest/metro/ — not a
  // domain root, so the prefix Worker is enabled. See worker/index.js.
  "main": "./worker/index.js",

  "assets": {
    "directory": "./web/dist",
    // Required because there is a `main`: it is how the Worker reads assets.
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // The bare prefix, no trailing slash. Must match the routes attached to the
  // Worker in the Cloudflare dashboard.
  "vars": { "ASSET_PREFIX": "/metro" }
}
