# Dependencies
node_modules/
web/node_modules/

# Build output
dist/
game/dist-unity-ui/
web/dist/

# Generated: the concept sheets are copied from art/ at build time
web/public/art/
# Generated: the example-station previews come from game/src/assets/stations
web/public/stations/
model/public/models/
# Interrupted model exports
*.glb.*.tmp

# Wrangler
.wrangler/
.dev.vars
.dev.vars.*
# Production Worker secrets kept locally (pushed with `wrangler secret bulk`)
.secrets.json
.secrets/
worker-configuration.d.ts

# Local tooling
.vite/
*.local
.cache/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Scratch preview/review outputs (browser profiles, experiment scripts, screenshots)
.preview/
slope-cut-preview/

# Rendered video deliverables (kept beside the editable save and thumbnail)
*.mp4

# Captured command output (npm test, tsc) accidentally saved to the repo root
/testout*.txt
/tscout.txt

# One machine's own caches and one-off probes
game/.rolldown-locked/
tools/_probe-sweep.mjs

# npm is this repo's manager; package-lock.json files are tracked for every app
web/pnpm-lock.yaml

