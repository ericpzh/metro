{
  // Station Designer — the game. Its own Worker project, separate from
  // the art site (`metro`).
  //
  // Served at https://stationdesigner.com/game/ (English: /game/en/). The
  // routes are attached here, so `wrangler deploy` creates them; the site's
  // Worker answers the rest of the hostname and loses these to the more
  // specific match.
  //
  //   stationdesigner.com/game     (the bare path)
  //   stationdesigner.com/game/*   (everything under it)
  //
  // The Worker's own workers.dev root keeps working at the same time.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "metro-game",
  "compatibility_date": "2026-09-29",

  "routes": [
    { "pattern": "stationdesigner.com/game", "zone_name": "stationdesigner.com" },
    { "pattern": "stationdesigner.com/game/*", "zone_name": "stationdesigner.com" }
  ],

  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    // Required because there is a `main`: it is how the Worker reads assets.
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // The prefix the Worker strips before reading an asset. A bare route and a
  // wildcard route are both needed: `/game/*` does not match `/game`. Never
  // collapse them into `/game*` — `*` spans `/`, so it would also swallow
  // `/gameplay` and hand it to this Worker. To host the game at its own
  // workers.dev root, delete `main`, the assets binding, `routes` and this
  // var, and set `not_found_handling` back to "single-page-application".
  "vars": { "ASSET_PREFIX": "/game" }
}
