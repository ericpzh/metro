{
  "name": "metro-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Metro Station Designer — the game. Playable vertical slice: build a station, watch the crowd break it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.mjs\"",
    "bench": "node bench/crowd.mjs 3000 1000 0 40 200",
    "bench:crush": "node bench/crowd.mjs 3000 1000 0 40 25"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
